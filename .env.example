# Server
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000,http://localhost:3001

# MongoDB Atlas Database URL
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://admin:yourpassword@cluster0.mongodb.net/zeru_printing?retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET="zeru_printing_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="30d"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Initial Admin Access PIN / Password
ADMIN_DEFAULT_PIN="281120"

# Google Drive Storage (Service Account)
# Optional: If not provided, files will be saved to server /uploads folder
GOOGLE_DRIVE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"

# Telegram Bot Notification (Order & Deposit Alerts)
# Optional: Telegram bot sends instant alerts to your phone
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="987654321"
